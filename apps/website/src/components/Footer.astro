---
import { BRAND_CONSTANTS } from '@digikhojindia/shared';

const currentYear = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-white/10 bg-[#080D20]/90 backdrop-blur-2xl text-slate-400">
  {/* Top Liquid Border Light */}
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Col 1: Brand Info with Official Emblem -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="relative w-12 h-12 rounded-full p-[2px] bg-gradient-to-tr from-[#F078C8] via-[#42DDF5] to-[#10B981] shadow-[0_0_20px_rgba(66,221,245,0.4)]">
            <div class="w-full h-full rounded-full bg-[#080D20] p-1 flex items-center justify-center overflow-hidden border border-white/20">
              <img src="/logo.png" alt="DigiKhojIndia Logo" class="w-full h-full object-contain filter drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)]" />
            </div>
          </div>

          <div class="flex flex-col text-left leading-tight">
            <div class="font-heading font-black tracking-tight text-2xl flex items-center">
              <span class="text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]">DigiKhoj</span>
              <span class="text-gradient-saffron font-black ml-0.5 drop-shadow-[0_1px_3px_rgba(249,115,22,0.4)]">India</span>
            </div>
            <span class="text-xs text-slate-400 font-medium italic mt-0.5">
              <span class="text-slate-300">Technology</span> की हर नई खोज, <span class="text-cyan-400 font-semibold">आपके लिए!</span>
            </span>
          </div>
        </a>

        <p className="text-xs text-slate-300 leading-relaxed max-w-sm">
          "We Don't Just Build Software. We Automate Your Entire Business."
        </p>

        <p className="text-xs text-slate-400 leading-relaxed max-w-sm">
          Enterprise custom software engineering, Hospital Information Systems (HMIS), complete workflow automation, and digital infrastructure management.
        </p>

        <div class="pt-2 text-xs space-y-1">
          <p><span class="text-slate-500">Official Email:</span> <a href={`mailto:${BRAND_CONSTANTS.OFFICIAL_EMAIL}`} class="text-cyan-400 hover:underline">{BRAND_CONSTANTS.OFFICIAL_EMAIL}</a></p>
          <p><span class="text-slate-500">Founder & Owner:</span> <strong class="text-white">{BRAND_CONSTANTS.OWNER_NAME}</strong></p>
          <p><span class="text-slate-500">Support Desk:</span> <span class="text-slate-200">+91 99999 99999 (24x7 Enterprise)</span></p>
        </div>
      </div>

      <!-- Col 2: Core Services -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-white font-heading uppercase tracking-wider">Enterprise Services</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/services/hospital-management" class="hover:text-cyan-400 transition-colors">Hospital Management (HMIS)</a></li>
          <li><a href="/services/custom-software" class="hover:text-cyan-400 transition-colors">Custom Software Development</a></li>
          <li><a href="/services/business-automation" class="hover:text-cyan-400 transition-colors">Business Process Automation</a></li>
          <li><a href="/services/crm-solutions" class="hover:text-cyan-400 transition-colors">CRM & Lead Automation</a></li>
          <li><a href="/services/website-development" class="hover:text-cyan-400 transition-colors">Web Application Engineering</a></li>
          <li><a href="/services/it-infrastructure" class="hover:text-cyan-400 transition-colors">Server & IT Infrastructure</a></li>
        </ul>
      </div>

      <!-- Col 3: Solutions & Portfolio -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-white font-heading uppercase tracking-wider">Software Solutions</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/portfolio" class="hover:text-cyan-400 transition-colors">Software Portfolio Catalog</a></li>
          <li><a href="/industries" class="hover:text-cyan-400 transition-colors">Healthcare & Diagnostics</a></li>
          <li><a href="/industries" class="hover:text-cyan-400 transition-colors">Enterprise & Corporate</a></li>
          <li><a href="/case-studies" class="hover:text-cyan-400 transition-colors">Client Case Studies</a></li>
          <li><a href="/tutorials" class="hover:text-cyan-400 transition-colors">Video Tutorials & Demos</a></li>
          <li><a href="/blog" class="hover:text-cyan-400 transition-colors">Tech News & Insights</a></li>
        </ul>
      </div>

      <!-- Col 4: Portals & Legal -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-white font-heading uppercase tracking-wider">Client Portals & Policy</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/login" class="text-cyan-400 hover:text-cyan-300 font-semibold transition-colors flex items-center gap-1">Client Support Portal <span>→</span></a></li>
          <li><a href="/request-demo" class="hover:text-cyan-400 transition-colors">Request Software Demo</a></li>
          <li><a href="/request-quote" class="hover:text-cyan-400 transition-colors">Request a Quote</a></li>
          <li><a href="/amc-policy" class="hover:text-cyan-400 transition-colors">Lifetime AMC Policy</a></li>
          <li><a href="/privacy" class="hover:text-cyan-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-cyan-400 transition-colors">Terms of Service</a></li>
          <li><a href="/refund-policy" class="hover:text-cyan-400 transition-colors">Refund Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Mandatory Ownership Bar -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div class="flex flex-col sm:flex-row items-center gap-2">
        <p class="text-slate-300 font-medium">© {currentYear} {BRAND_CONSTANTS.COMPANY_NAME}. All Rights Reserved.</p>
        <span class="hidden sm:inline">•</span>
        <p class="text-cyan-400 font-bold">Owned by {BRAND_CONSTANTS.OWNER_NAME}.</p>
      </div>

      <div class="text-[11px] text-slate-400">
        <span>Lifetime Free AMC – Subject to agreed contract terms.</span>
      </div>
    </div>
  </div>
</footer>
