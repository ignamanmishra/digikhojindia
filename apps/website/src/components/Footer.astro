---
import { BRAND_CONSTANTS } from '@digikhojindia/shared';

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Col 1: Brand & Ownership -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2 text-white font-bold text-2xl tracking-tight">
          <span class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white text-lg font-black">D</span>
          <span>Digikhojindia</span>
        </a>
        <p class="text-sm text-slate-400 font-medium">
          "{BRAND_CONSTANTS.TAGLINE}"
        </p>
        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Digikhojindia is a technology, software development, business automation, IT solutions and digital growth company. We automate operations for hospitals, enterprises, diagnostic labs and growing businesses.
        </p>
        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <p><span class="text-slate-300 font-semibold">Founder & Owner:</span> {BRAND_CONSTANTS.OWNER_NAME}</p>
          <p><span class="text-slate-300 font-semibold">Official Email:</span> <a href={`mailto:${BRAND_CONSTANTS.OFFICIAL_EMAIL}`} class="text-blue-400 hover:underline">{BRAND_CONSTANTS.OFFICIAL_EMAIL}</a></p>
          <p class="text-blue-400 font-medium">{BRAND_CONSTANTS.LIFETIME_AMC_NOTE}</p>
        </div>
      </div>

      <!-- Col 2: Solutions & Services -->
      <div>
        <h4 class="text-white text-sm font-semibold tracking-wider uppercase mb-4">Core Services</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/services/hospital-management" class="hover:text-white transition-colors">Hospital Management (HMIS)</a></li>
          <li><a href="/services/custom-software" class="hover:text-white transition-colors">Custom Software Development</a></li>
          <li><a href="/services/business-automation" class="hover:text-white transition-colors">Business Process Automation</a></li>
          <li><a href="/services/crm-solutions" class="hover:text-white transition-colors">CRM & Lead Management</a></li>
          <li><a href="/services/website-development" class="hover:text-white transition-colors">Web App Development</a></li>
          <li><a href="/services/it-infrastructure" class="hover:text-white transition-colors">IT Infrastructure & Servers</a></li>
          <li><a href="/services/seo-geo" class="hover:text-white transition-colors">Local SEO & GEO Visibility</a></li>
        </ul>
      </div>

      <!-- Col 3: Software Products & Portfolio -->
      <div>
        <h4 class="text-white text-sm font-semibold tracking-wider uppercase mb-4">Software Modules</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/portfolio#hmis" class="hover:text-white transition-colors">HMIS OPD/IPD & Billing</a></li>
          <li><a href="/portfolio#director-dashboard" class="hover:text-white transition-colors">Director / CEO Dashboard</a></li>
          <li><a href="/portfolio#lis-analyzer" class="hover:text-white transition-colors">LIS Analyzer Interfacing</a></li>
          <li><a href="/portfolio#asset-management" class="hover:text-white transition-colors">Asset Management Portal</a></li>
          <li><a href="/portfolio#whatsapp-automation" class="hover:text-white transition-colors">WhatsApp & IVR Automation</a></li>
          <li><a href="/portfolio#salon-cosmetic" class="hover:text-white transition-colors">Cosmetic & Salon Software</a></li>
          <li><a href="/portfolio" class="text-blue-400 hover:text-blue-300 font-semibold">View All 15+ Modules →</a></li>
        </ul>
      </div>

      <!-- Col 4: Portals & Legal -->
      <div>
        <h4 class="text-white text-sm font-semibold tracking-wider uppercase mb-4">Client Portals & Legal</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="http://localhost:5174" target="_blank" rel="noreferrer" class="text-blue-400 hover:text-blue-300 font-medium">Customer Support Portal ↗</a></li>
          <li><a href="http://localhost:5173" target="_blank" rel="noreferrer" class="text-slate-400 hover:text-white">Admin Operations Panel ↗</a></li>
          <li><a href="/request-demo" class="hover:text-white transition-colors">Request a Live Demo</a></li>
          <li><a href="/request-quote" class="hover:text-white transition-colors">Get Turnkey Quote</a></li>
          <li><a href="/amc-policy" class="hover:text-white transition-colors">AMC Terms & Policy</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms and Conditions</a></li>
          <li><a href="/refund-policy" class="hover:text-white transition-colors">Refund Policy</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>{BRAND_CONSTANTS.FOOTER_COPYRIGHT} <span class="text-slate-200 font-semibold">{BRAND_CONSTANTS.FOOTER_OWNERSHIP}</span></p>
      <div class="flex items-center gap-6">
        <span>Cloudflare-Native Architecture</span>
        <span class="inline-block w-1 h-1 rounded-full bg-slate-600"></span>
        <span>Secure Multi-Tenant Platform</span>
      </div>
    </div>
  </div>
</footer>
