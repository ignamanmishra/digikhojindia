---
import { BRAND_CONSTANTS } from '@digikhojindia/shared';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Software Portfolio', href: '/portfolio' },
  { label: 'Industries', href: '/industries' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog & News', href: '/blog' },
  { label: 'Videos', href: '/videos' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 to-sky-500 flex items-center justify-center text-white font-black text-xl shadow-md shadow-blue-500/20">
          D
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-white block leading-tight">Digikhojindia</span>
          <span class="text-[10px] tracking-wider text-slate-400 uppercase font-semibold block">Automation & Software</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => {
          const isActive = activePath === item.href || (item.href !== '/' && activePath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-colors ${
                isActive
                  ? 'text-white bg-slate-800'
                  : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/request-demo"
          class="text-xs font-semibold text-slate-300 hover:text-white px-3 py-2 rounded-lg transition-colors border border-slate-700 hover:border-slate-500"
        >
          Request Demo
        </a>
        <a
          href="http://localhost:5174"
          target="_blank"
          rel="noreferrer"
          class="text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg shadow-sm shadow-blue-500/20 transition-all flex items-center gap-1.5"
        >
          <span>Customer Login</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

    </div>
  </div>
</header>
