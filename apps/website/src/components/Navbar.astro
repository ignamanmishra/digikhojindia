---
interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Industries', href: '/industries' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#080D20]/75 backdrop-blur-xl border-b border-white/10 shadow-[0_4px_30px_rgba(0,0,0,0.5)] transition-all">
  {/* Top Liquid Gradient Rim */}
  <div class="h-[2px] w-full bg-gradient-to-r from-[#287BFF] via-[#42DDF5] to-[#9B70FF]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    <!-- Brand Logo with Official Trademark Emblem & Tagline -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative w-11 h-11 rounded-full p-[2px] bg-gradient-to-tr from-[#F078C8] via-[#42DDF5] to-[#10B981] shadow-[0_0_20px_rgba(66,221,245,0.4)] transition-transform duration-300 group-hover:scale-105">
        <div class="w-full h-full rounded-full bg-[#080D20] p-1 flex items-center justify-center overflow-hidden border border-white/20">
          <img src="/logo.png" alt="DigiKhojIndia Logo" class="w-full h-full object-contain filter drop-shadow-[0_2px_6px_rgba(0,0,0,0.8)]" />
        </div>
      </div>

      <div class="flex flex-col text-left leading-tight">
        <div class="font-heading font-black tracking-tight text-xl flex items-center">
          <span class="text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]">DigiKhoj</span>
          <span class="text-gradient-saffron font-black ml-0.5 drop-shadow-[0_1px_3px_rgba(249,115,22,0.4)]">India</span>
        </div>
        <span class="text-[10px] text-slate-400 font-medium italic -mt-0.5">
          <span class="text-slate-300">Technology</span> की हर नई खोज, <span class="text-cyan-400 font-semibold">आपके लिए!</span>
        </span>
      </div>
    </a>

    <!-- Desktop Menu Navigation -->
    <nav class="hidden lg:flex items-center gap-1 p-1.5 rounded-2xl bg-white/[0.04] backdrop-blur-md border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]">
      {navLinks.map((link) => {
        const isActive = activePath === link.href || (link.href !== '/' && activePath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3.5 py-1.5 rounded-xl text-xs font-semibold select-none transition-all duration-200 ${
              isActive
                ? 'bg-gradient-to-r from-[#287BFF]/40 to-[#42DDF5]/30 text-cyan-300 border border-cyan-400/40 shadow-[0_0_15px_rgba(66,221,245,0.25)]'
                : 'text-slate-300 hover:text-white hover:bg-white/[0.08]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Side Actions: Client Login & Request Demo -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/login"
        class="text-xs font-semibold text-slate-300 hover:text-cyan-300 px-3 py-2 rounded-xl hover:bg-white/5 transition-all"
      >
        Client Login
      </a>

      <a
        href="/request-demo"
        class="relative group px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-[#287BFF] via-[#42DDF5] to-[#9B70FF] shadow-[0_0_20px_rgba(66,221,245,0.35)] hover:shadow-[0_0_30px_rgba(40,123,255,0.5)] border border-white/20 transition-all transform hover:scale-[1.02] flex items-center gap-1.5 overflow-hidden"
      >
        <span class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/70 to-transparent pointer-events-none"></span>
        <span>Request Demo</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex lg:hidden items-center">
      <button
        type="button"
        id="mobile-menu-toggle"
        class="p-2 rounded-xl text-slate-300 hover:text-white bg-white/5 border border-white/10"
        aria-label="Toggle Navigation"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-white/10 bg-[#080D20]/95 backdrop-blur-2xl px-6 py-5 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/5"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-4 border-t border-white/10 flex flex-col gap-2">
      <a
        href="/login"
        class="w-full text-center py-2.5 text-xs font-semibold text-slate-200 bg-white/5 rounded-xl border border-white/10"
      >
        Client Login
      </a>
      <a
        href="/request-demo"
        class="w-full text-center py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#287BFF] via-[#42DDF5] to-[#9B70FF] rounded-xl shadow-[0_0_20px_rgba(66,221,245,0.4)]"
      >
        Request a Demo
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
