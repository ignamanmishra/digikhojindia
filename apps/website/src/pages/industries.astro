---
import Layout from '../layouts/Layout.astro';
import { EnquiryForm } from '../components/EnquiryForm';

const industries = [
  {
    title: 'Multi-Speciality Hospitals & Medical Colleges',
    icon: '🏥',
    desc: 'Paperless OPD, IPD, Operation Theatre schedules, Ayushman Bharat & TPA billing, nurse stations, and centralized pharmacy dispensing.',
  },
  {
    title: 'Diagnostic Pathology & Radiology Centers',
    icon: '🔬',
    desc: 'Automated bi-directional analyzer interfacing (ASTM & HL7), barcode blood sample tracking, instant WhatsApp PDF reports, and radiologist templates.',
  },
  {
    title: 'Single-Doctor & Multi-Specialist Clinics',
    icon: '🩺',
    desc: 'Rapid appointment scheduling, digital prescription pad, patient history timeline, and automated WhatsApp appointment reminders.',
  },
  {
    title: 'Cosmetic Dermatology & Aesthetic Salons',
    icon: '✨',
    desc: 'Package voucher memberships, treatment session charting, stylist commission ledgers, and client retention loyalty programs.',
  },
  {
    title: 'Enterprise & Supply Chain Organizations',
    icon: '🏢',
    desc: 'Custom web ERPs, asset tracking with QR-code maintenance, purchase orders, multi-level approval hierarchies, and MIS reporting.',
  },
  {
    title: 'Startups & Growing Brands',
    icon: '🚀',
    desc: 'Rapid cloud application development, sub-10ms edge performance, automated lead pipelines, and CRM integration.',
  },
];
---

<Layout
  title="Industries We Serve | Digikhojindia Domain Automation"
  description="Discover how Digikhojindia tailors software automation for hospitals, diagnostic labs, clinics, aesthetic centers, and enterprise organizations."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Tailored Domain Engineering</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Industries We Serve
      </h1>
      <p class="mt-4 text-sm text-slate-300">
        Every sector has distinct operational workflows, regulatory compliances, and customer touchpoints. We engineer solutions built specifically for your field.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {industries.map((ind) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 hover:border-slate-700 transition-all">
          <div class="text-4xl mb-4">{ind.icon}</div>
          <h3 class="text-xl font-bold text-white mb-3">{ind.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{ind.desc}</p>
        </div>
      ))}
    </div>

    <div class="max-w-2xl mx-auto">
      <h3 class="text-xl font-bold text-white text-center mb-6">Discuss Your Industry Requirements</h3>
      <EnquiryForm client:load defaultType="demo" />
    </div>
  </div>
</Layout>
