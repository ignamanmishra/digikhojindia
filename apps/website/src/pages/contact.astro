---
import Layout from '../layouts/Layout.astro';
import { EnquiryForm } from '../components/EnquiryForm';
import { BRAND_CONSTANTS } from '@digikhojindia/shared';
---

<Layout
  title="Contact Us | Digikhojindia"
  description="Connect with Digikhojindia for enterprise software engineering, hospital HMIS consultation, and custom business automation."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Direct Communication</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Connect With Our Engineering Team
      </h1>
      <p class="mt-4 text-sm text-slate-300">
        Have a question about our software modules, custom development timeline, or IT infrastructure support? Reach out directly.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5 space-y-6">
        <div class="p-6 rounded-3xl bg-gradient-to-br from-white/[0.07] via-[#102B50]/40 to-white/[0.02] backdrop-blur-2xl border border-white/15 shadow-[0_8px_32px_0_rgba(0,0,0,0.4)] space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <h3 class="text-base font-bold text-white font-heading">Direct Enterprise Channels</h3>
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/60 px-2.5 py-1 rounded-full border border-emerald-500/30">
              Live & Responsive
            </span>
          </div>

          <div class="space-y-4 text-xs text-slate-300">
            <!-- Mobile Phone & WhatsApp -->
            <div class="p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-cyan-400/40 transition-colors">
              <p class="text-slate-400 text-[11px] font-semibold mb-1">Official Mobile & Helpline</p>
              <div class="flex items-center justify-between">
                <a href={BRAND_CONSTANTS.PHONE_TEL} class="text-cyan-300 font-extrabold text-sm tracking-wide hover:underline">
                  {BRAND_CONSTANTS.OFFICIAL_PHONE}
                </a>
                <a
                  href={BRAND_CONSTANTS.WHATSAPP_LINK}
                  target="_blank"
                  rel="noreferrer"
                  class="text-[11px] font-bold text-white bg-emerald-600 hover:bg-emerald-500 px-3 py-1 rounded-xl shadow-[0_0_15px_rgba(16,185,129,0.4)] transition-all flex items-center gap-1"
                >
                  <span>WhatsApp</span>
                  <span>→</span>
                </a>
              </div>
              <p class="text-[10px] text-slate-400 mt-1">Direct escalation to technical solutions team</p>
            </div>

            <!-- Email Inquiries -->
            <div class="p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 hover:border-cyan-400/40 transition-colors space-y-2">
              <p class="text-slate-400 text-[11px] font-semibold">Official Email Addresses</p>
              <div>
                <span class="text-slate-400 text-[10px] block">General & Enterprise Inquiries:</span>
                <a href={`mailto:${BRAND_CONSTANTS.SECONDARY_NOTIFICATION_EMAIL}`} class="text-cyan-400 font-bold hover:underline">
                  {BRAND_CONSTANTS.SECONDARY_NOTIFICATION_EMAIL}
                </a>
              </div>
              <div>
                <span class="text-slate-400 text-[10px] block">Executive Leadership Desk:</span>
                <a href={`mailto:${BRAND_CONSTANTS.PRIMARY_NOTIFICATION_EMAIL}`} class="text-cyan-400 font-bold hover:underline">
                  {BRAND_CONSTANTS.PRIMARY_NOTIFICATION_EMAIL}
                </a>
              </div>
            </div>

            <!-- Founder & Ownership -->
            <div class="p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 space-y-1">
              <p class="text-slate-400 text-[11px] font-semibold">Leadership & Ownership</p>
              <p class="font-bold text-white text-xs">{BRAND_CONSTANTS.OWNER_NAME} (Founder & Owner)</p>
              <p class="text-[10px] text-slate-400 italic">"Technology की हर नई खोज, आपके लिए!"</p>
            </div>

            <!-- Business Hours -->
            <div class="p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 space-y-1">
              <p class="text-slate-400 text-[11px] font-semibold">Operational Schedule</p>
              <p class="font-bold text-white text-xs">Monday – Saturday: 9:00 AM – 7:00 PM IST</p>
              <p class="text-[10px] text-emerald-400 font-medium">24/7 Priority Emergency SLA for HMIS & Critical Deployments</p>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-gradient-to-br from-[#102B50]/60 via-[#080D20]/80 to-white/[0.02] backdrop-blur-2xl border border-cyan-500/30 shadow-[0_0_30px_rgba(40,123,255,0.2)]">
          <h4 class="text-xs font-bold uppercase tracking-wider text-cyan-300 mb-1.5">Existing Client with Active SLA?</h4>
          <p class="text-xs text-slate-300 mb-4 leading-relaxed">
            If your hospital or enterprise has an active software deployment, log directly into the Customer Portal to raise high-priority complaints and track resolution.
          </p>
          <a
            href="http://localhost:5174"
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 rounded-xl text-white bg-gradient-to-r from-[#287BFF] via-[#42DDF5] to-[#9B70FF] shadow-[0_0_20px_rgba(66,221,245,0.35)] hover:shadow-[0_0_30px_rgba(40,123,255,0.5)] transition-all"
          >
            <span>Launch Customer Support Portal</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <EnquiryForm client:load defaultType="contact" />
      </div>
    </div>
  </div>
</Layout>

