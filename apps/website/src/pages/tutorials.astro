---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Software Tutorials & Guides | Digikhojindia"
  description="Step-by-step guides for mastering business automation, HMIS workflows, and CRM lead capture."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Step-by-Step Training</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Software Tutorials & User Guides
      </h1>
      <p class="mt-4 text-sm text-slate-300">
        Hands-on walkthroughs designed to get hospital staff, sales executives, and administrators up to speed quickly.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <span class="text-xs font-bold text-blue-400 uppercase">Hospital Operations</span>
        <h3 class="text-lg font-bold text-white mt-1 mb-2">Generating Discharge Summaries in Under 3 Minutes</h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          Learn how to pull lab diagnostics, medication records, and consultant notes into standardized hospital discharge templates with digital signatures.
        </p>
        <a href="/videos" class="text-xs text-blue-400 font-semibold hover:underline">Watch Tutorial Video →</a>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <span class="text-xs font-bold text-blue-400 uppercase">CRM Pipeline</span>
        <h3 class="text-lg font-bold text-white mt-1 mb-2">Configuring Automated WhatsApp Lead Reminders</h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          A step-by-step configuration guide to connect Meta Cloud API webhook triggers to automatically message qualified sales leads.
        </p>
        <a href="/videos" class="text-xs text-blue-400 font-semibold hover:underline">Watch Tutorial Video →</a>
      </div>
    </div>
  </div>
</Layout>
