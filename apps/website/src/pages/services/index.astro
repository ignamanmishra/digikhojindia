---
import Layout from '../../layouts/Layout.astro';

const services = [
  {
    title: 'Hospital Management Systems (HMIS)',
    slug: '/services/hospital-management',
    description: 'Complete paperless automation for multi-specialty hospitals, nursing homes, and clinics. OPD, IPD, OT, Pharmacy, LIS, EHR, and Ayushman Bharat billing.',
    icon: '🏥',
  },
  {
    title: 'Custom Software Development',
    slug: '/services/custom-software',
    description: 'Bespoke web applications, SaaS platforms, and enterprise workflows engineered with Cloudflare-native architecture and strict multi-tenant isolation.',
    icon: '💻',
  },
  {
    title: 'Business Process Automation',
    slug: '/services/business-automation',
    description: 'Event-driven pipelines connecting website leads, billing notifications, WhatsApp alerts, and internal task delegation without manual intervention.',
    icon: '⚡',
  },
  {
    title: 'CRM & Lead Management Solutions',
    slug: '/services/crm-solutions',
    description: 'Omnichannel lead capture, multi-stage sales funnels, follow-up scheduling, and conversion analytics.',
    icon: '📈',
  },
  {
    title: 'Website & Web Application Development',
    slug: '/services/website-development',
    description: 'Sub-10ms latency web applications built with Astro, React, and Cloudflare Workers.',
    icon: '🌐',
  },
  {
    title: 'Google Business Profile Management',
    slug: '/services/google-business-profile',
    description: 'Local presence optimization, review management, location ranking, and local customer acquisition.',
    icon: '📍',
  },
  {
    title: 'Local SEO & GEO Optimization',
    slug: '/services/seo-geo',
    description: 'Structured schemas, Generative Engine Optimization (GEO) for AI search engines, and factual knowledge graphs.',
    icon: '🤖',
  },
  {
    title: 'IT Infrastructure & Lifetime Free AMC',
    slug: '/services/it-infrastructure',
    description: 'Turnkey network setup, server administration, CCTV maintenance, and our signature Lifetime Free AMC terms.',
    icon: '🛡️',
  },
];
---

<Layout
  title="Our Services | Digikhojindia Business Automation & Software"
  description="Explore Digikhojindia's full suite of enterprise software engineering, hospital HMIS systems, business process automation, and IT infrastructure solutions."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Comprehensive Solutions</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Services Engineered for Autonomous Growth
      </h1>
      <p class="mt-4 text-base text-slate-300">
        We specialize in transforming manual, paper-intensive operations into automated, ultra-responsive digital systems.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((svc) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 hover:border-blue-500/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-4xl mb-4">{svc.icon}</div>
            <h3 class="text-xl font-bold text-white mb-3">{svc.title}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{svc.description}</p>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-800">
            <a href={svc.slug} class="text-xs font-semibold text-blue-400 hover:text-blue-300 flex items-center justify-between">
              <span>Explore Detailed Specifications</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
