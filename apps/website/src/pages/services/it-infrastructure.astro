---
import Layout from '../../layouts/Layout.astro';
import { EnquiryForm } from '../../components/EnquiryForm';
import { BRAND_CONSTANTS } from '@digikhojindia/shared';
---

<Layout
  title="IT Infrastructure Management & Lifetime Free AMC | Digikhojindia"
  description="Enterprise IT infrastructure support: servers, network security, CCTV maintenance, and our signature Lifetime Free AMC terms."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Total Infrastructure Reliability</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        IT Infrastructure & AMC Management
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        From local area networking (LAN) and server virtualization to IP CCTV and network firewall management, we keep your physical and cloud operations uninterrupted.
      </p>
    </div>

    <!-- Free AMC Focus Box -->
    <div class="bg-gradient-to-r from-blue-950/60 to-slate-900 border border-blue-500/40 rounded-2xl p-8 mb-16">
      <div class="flex items-center gap-3 mb-2">
        <span class="px-2.5 py-1 rounded bg-blue-600 text-white font-bold text-xs uppercase">Core Proposition</span>
        <span class="text-xs text-blue-300 font-semibold">{BRAND_CONSTANTS.LIFETIME_AMC_NOTE}</span>
      </div>
      <h3 class="text-2xl font-bold text-white mb-2">Eliminate Recurring Maintenance Headaches</h3>
      <p class="text-xs text-slate-300 leading-relaxed max-w-3xl">
        We do not believe in hitting clients with exorbitant recurring fees just to keep their system running. Our AMC covers scheduled database backups, security patches, index re-tuning, and priority ticketing support.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Server & Cloud Migration</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Migrate high-cost on-premise servers to modern Cloudflare Worker and containerized clouds.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">High-Speed Networking</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Structured cabling, enterprise WiFi access points, and VLAN segmentation between clinical and guest networks.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">CCTV & Access Control</h3>
        <p class="text-xs text-slate-400 leading-relaxed">IP camera surveillance integration with remote viewing, biometric attendance, and automated door relays.</p>
      </div>
    </div>

    <div class="max-w-2xl mx-auto">
      <h3 class="text-xl font-bold text-white text-center mb-6">Request Infrastructure Audit</h3>
      <EnquiryForm client:load defaultType="quote" defaultService="IT Infrastructure & Server Support" />
    </div>
  </div>
</Layout>

