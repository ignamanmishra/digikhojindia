---
import Layout from '../../layouts/Layout.astro';
import { EnquiryForm } from '../../components/EnquiryForm';
---

<Layout
  title="CRM & Lead Management Solutions | Digikhojindia"
  description="Turn inquiries into long-term clients with Digikhojindia's customized CRM system. Multi-stage sales pipelines, follow-ups, and conversion tracking."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Sales Acceleration</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        CRM & Lead Management
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        Never lose another sales lead. Manage prospects through clear stages: New → Contacted → Qualified → Proposal → Negotiation → Won / Lost.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Omnichannel Intake</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Capture leads from website contact forms, demo requests, Google Business Profile, and WhatsApp chats in one unified view.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Automated Follow-ups</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Schedule reminders for your sales reps and automatically send follow-up emails and messages at scheduled intervals.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Conversion Reports</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Real-time charts showing pipeline value, win/loss ratios, representative performance, and ROI across acquisition sources.</p>
      </div>
    </div>

    <div class="max-w-2xl mx-auto">
      <h3 class="text-xl font-bold text-white text-center mb-6">Upgrade Your Sales Pipeline</h3>
      <EnquiryForm client:load defaultType="demo" defaultService="CRM & Lead Management System" />
    </div>
  </div>
</Layout>
