---
import Layout from '../../layouts/Layout.astro';
import { EnquiryForm } from '../../components/EnquiryForm';
import { BRAND_CONSTANTS } from '@digikhojindia/shared';
---

<Layout
  title="Business Process Automation | Digikhojindia"
  description="Automate repetitive tasks, lead qualification, billing reminders, and WhatsApp alerts with Digikhojindia's event-driven automation engine."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Autonomous Operations</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Business Process Automation
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        "{BRAND_CONSTANTS.TAGLINE}" We link your web inquiries, customer communications, billing, and task management into automated event pipelines.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Instant Lead-to-CRM Routing</h3>
        <p class="text-xs text-slate-400 leading-relaxed">When a prospect fills out a website form, a CRM lead is generated in milliseconds, sales reps get WhatsApp pings, and the client receives a brochure deck automatically.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Billing & Overdue Invoicing Alerts</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Zero manual chasing. Automated, polite payment reminders via WhatsApp and email 7 days before due date and on due date.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Support Ticket SLA Timers</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Automatic calculation of 4h/12h/24h SLA deadlines based on severity, escalating overdue tickets directly to management.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">AMC Validity Reminders</h3>
        <p class="text-xs text-slate-400 leading-relaxed">System notifications generated 30 days prior to contract expiration, preparing renewal reviews effortlessly.</p>
      </div>
    </div>

    <div class="max-w-2xl mx-auto">
      <h3 class="text-xl font-bold text-white text-center mb-6">Automate Your Operations</h3>
      <EnquiryForm client:load defaultType="demo" defaultService="Business Process Automation" />
    </div>
  </div>
</Layout>

