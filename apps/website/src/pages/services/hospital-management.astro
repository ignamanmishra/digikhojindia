---
import Layout from '../../layouts/Layout.astro';
import { EnquiryForm } from '../../components/EnquiryForm';

const hmisFeatures = [
  { title: 'OPD & Patient Registration', desc: 'Fast barcode token queue, smart doctor scheduling, and digital prescription builder.' },
  { title: 'IPD & Bed Management', desc: 'Real-time bed occupancy heatmap, nursing admission notes, and daily round monitoring.' },
  { title: 'Integrated Billing & TPA Support', desc: 'Automatic itemization, Ayushman Bharat packages, private TPA claims, and multi-mode payment.' },
  { title: 'Pharmacy & Drug Inventory', desc: 'Expiry alerts, batch tracking, automatic prescription-to-pharmacy dispensing sync.' },
  { title: 'Laboratory (LIS) Interfacing', desc: 'Direct bi-directional interfacing with biochemistry and hematology analyzers via ASTM/HL7.' },
  { title: 'Operation Theatre (OT) Scheduling', desc: 'Surgeon slot booking, PAC pre-anaesthetic notes, and surgical implant consumption tracking.' },
];
---

<Layout
  title="Hospital Management Systems (HMIS) | Digikhojindia Healthcare"
  description="Enterprise paperless hospital management software (HMIS). OPD, IPD, Billing, Laboratory LIS, Pharmacy, and EHR with Lifetime Free AMC."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Healthcare Excellence</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Complete Hospital Management System (HMIS)
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        Transform your hospital into a high-efficiency paperless institution. Engineered on Cloudflare Workers for sub-10ms response times across every OPD counter and nursing station.
      </p>
    </div>

    <!-- Modules Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      {hmisFeatures.map((f) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
          <h3 class="text-lg font-bold text-white mb-2">{f.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

    <!-- Hospital ROI & Free AMC Commitment -->
    <div class="bg-gradient-to-r from-blue-950/60 to-slate-900 border border-blue-500/30 rounded-2xl p-8 mb-20 text-center sm:text-left sm:flex items-center justify-between gap-8">
      <div>
        <h3 class="text-2xl font-bold text-white mb-2">Lifetime Free AMC on Digikhojindia HMIS</h3>
        <p class="text-xs text-slate-300 max-w-xl">
          Subject to agreed contract terms, our hospital deployments include continuous bug patches, database indexing, and priority 4-hour SLA ticket resolution.
        </p>
      </div>
      <a href="/request-demo?module=hmis" class="mt-4 sm:mt-0 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-lg shrink-0">
        Schedule Live Hospital Demo →
      </a>
    </div>

    <!-- Enquiry Form for HMIS -->
    <div class="max-w-2xl mx-auto">
      <h3 class="text-xl font-bold text-white text-center mb-6">Request HMIS Consultation & Architecture Deck</h3>
      <EnquiryForm client:load defaultType="demo" defaultService="Hospital Management Software (HMIS)" />
    </div>
  </div>
</Layout>

