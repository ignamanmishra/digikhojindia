---
import Layout from '../../layouts/Layout.astro';
import { EnquiryForm } from '../../components/EnquiryForm';
---

<Layout
  title="Website & Web Application Development | Digikhojindia"
  description="High performance, responsive, secure web applications built on Astro, React, TypeScript and Cloudflare Workers."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Modern Web Architecture</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Website & Web Application Development
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        Fast, accessible, and conversion-optimized websites. We build with modern frontend frameworks and deploy directly to Cloudflare edge networks for lightning-fast speeds worldwide.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Sub-Second Load Times</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Static site generation with dynamic island architecture ensures perfect 100/100 Core Web Vitals scores.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Mobile-First UI/UX</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Tailored responsive design tested across smart phones, tablets, laptops, and ultra-wide enterprise monitors.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-bold text-white mb-2">Cloudflare Turnstile Defense</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Frictionless anti-bot protection on all forms without annoying CAPTCHA puzzles for your human visitors.</p>
      </div>
    </div>

    <div class="max-w-2xl mx-auto">
      <h3 class="text-xl font-bold text-white text-center mb-6">Build Your Modern Web Application</h3>
      <EnquiryForm client:load defaultType="quote" defaultService="Website & Cloud Web Application" />
    </div>
  </div>
</Layout>
