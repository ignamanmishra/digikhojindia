---
import Layout from '../layouts/Layout.astro';

const videos = [
  {
    title: 'Digikhojindia HMIS Product Walkthrough: OPD to IPD Workflow',
    category: 'Hospital Management Software',
    youtubeId: 'dQw4w9WgXcQ',
    desc: 'Complete end-to-end demonstration of the Digikhojindia Hospital Management System covering patient registration, consultation, lab orders, pharmacy dispensing, and final discharge billing.',
  },
  {
    title: 'WhatsApp Cloud API Business Automation Tutorial',
    category: 'Tutorials',
    youtubeId: 'dQw4w9WgXcQ',
    desc: 'Step-by-step tutorial on integrating WhatsApp Business Cloud API with CRM pipelines for instant lead auto-response.',
  },
];
---

<Layout
  title="Video Demonstrations & Product Walkthroughs | Digikhojindia"
  description="Watch product walkthroughs, live demonstrations, and software tutorials from Digikhojindia."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Visual Walkthroughs</span>
      <h1 class="text-4xl font-extrabold text-white tracking-tight mt-2 sm:text-5xl">
        Product Videos & Live Demos
      </h1>
      <p class="mt-4 text-sm text-slate-300">
        See how our software modules function in real-time operational environments.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {videos.map((vid) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
          <div class="aspect-video w-full bg-slate-950">
            <iframe
              class="w-full h-full"
              src={`https://www.youtube-nocookie.com/embed/${vid.youtubeId}`}
              title={vid.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <div class="p-6">
            <span class="text-[10px] font-bold text-blue-400 uppercase tracking-wider">{vid.category}</span>
            <h3 class="text-lg font-bold text-white mt-1 mb-2">{vid.title}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{vid.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

