---
import Layout from '../layouts/Layout.astro';
import { EnquiryForm } from '../components/EnquiryForm';
import { BRAND_CONSTANTS } from '@digikhojindia/shared';

const services = [
  {
    title: 'Hospital Management Systems (HMIS)',
    slug: '/services/hospital-management',
    description: 'Paperless hospital automation with OPD, IPD, Bed scheduling, Doctor appointments, Billing & EHR.',
    badge: 'Flagship Healthcare',
    icon: '🏥',
  },
  {
    title: 'Custom Software Development',
    slug: '/services/custom-software',
    description: 'Bespoke web and cloud applications built specifically for your unique operational workflows.',
    badge: 'Enterprise',
    icon: '💻',
  },
  {
    title: 'Business Process Automation',
    slug: '/services/business-automation',
    description: 'Eliminate repetitive manual entry. Connect enquiry intake, billing alerts, and tasks automatically.',
    badge: '10x Efficiency',
    icon: '⚡',
  },
  {
    title: 'CRM & Lead Management',
    slug: '/services/crm-solutions',
    description: 'Multi-stage sales pipelines, instant lead capture from web forms, and follow-up reminders.',
    badge: 'Revenue Growth',
    icon: '📈',
  },
  {
    title: 'Website & Web Application Development',
    slug: '/services/website-development',
    description: 'Fast, secure, responsive web applications engineered with Cloudflare-native modern architecture.',
    badge: 'High Performance',
    icon: '🌐',
  },
  {
    title: 'Google Business Profile & Local SEO',
    slug: '/services/google-business-profile',
    description: 'Optimize local search visibility, manage verified locations, and drive high-intent local inquiries.',
    badge: 'GEO Visibility',
    icon: '📍',
  },
  {
    title: 'AI & Generative Search Optimization (GEO)',
    slug: '/services/seo-geo',
    description: 'Structure your business knowledge and citations for next-generation AI engines and answer search.',
    badge: 'Future-Proof',
    icon: '🤖',
  },
  {
    title: 'IT Infrastructure & AMC Support',
    slug: '/services/it-infrastructure',
    description: 'Server management, networking, CCTV maintenance, and our signature Lifetime Free AMC terms.',
    badge: 'Lifetime Free AMC*',
    icon: '🛡️',
  },
];

const portfolioItems = [
  {
    id: 'hmis',
    name: 'Hospital Management System (HMIS)',
    category: 'Healthcare HMIS',
    tag: 'Sample / Demo Module',
    description: 'End-to-end hospital administration: OPD/IPD registers, digital discharge summary, TPA billing, pharmacy.',
    features: ['OPD/IPD Management', 'Integrated Billing & TPA', 'Ayushman Bharat Ready', 'Pharmacy Inventory'],
  },
  {
    id: 'director-dashboard',
    name: 'Director / CEO Dashboard',
    category: 'Executive Cockpit',
    tag: 'Sample / Demo Module',
    description: 'Real-time financial and clinical intelligence: collection heatmaps, doctor performance, bed occupancy.',
    features: ['Real-time Collections', 'Bed Occupancy Matrix', 'Department Margins', 'Receivables Aging'],
  },
  {
    id: 'lis-analyzer',
    name: 'Laboratory Management & LIS Interfacing',
    category: 'Diagnostic LIS',
    tag: 'Sample / Demo Module',
    description: 'Bi-directional serial & TCP/IP ASTM interfacing with biochemistry and hematology analyzers.',
    features: ['ASTM / HL7 Protocol', 'Barcode Printing', 'Instant WhatsApp Reports', 'Auto-Normal Validation'],
  },
  {
    id: 'asset-management',
    name: 'Asset Management Portal',
    category: 'IT & Facilities',
    tag: 'Sample / Demo Module',
    description: 'QR-code tagging for medical equipment and IT machines, breakdown ticketing, and vendor AMC audits.',
    features: ['QR Maintenance Log', 'Preventive Service Alerts', 'Breakdown Tickets', 'Warranty Tracking'],
  },
  {
    id: 'whatsapp-automation',
    name: 'WhatsApp, SMS & IVR Automation',
    category: 'Communication',
    tag: 'Sample / Demo Module',
    description: 'Official Meta Cloud API integration for automated appointment reminders and billing notifications.',
    features: ['Meta Cloud API', 'DLT SMS Integration', 'Interactive IVR Routing', 'Instant Bot Answers'],
  },
  {
    id: 'salon-cosmetic',
    name: 'Cosmetic & Salon Management',
    category: 'Aesthetic Clinic',
    tag: 'Sample / Demo Module',
    description: 'Appointment schedules, package vouchers, therapist commission logs, and client treatment logs.',
    features: ['Appointment Scheduling', 'Package Memberships', 'Stylist Commissions', 'Customer Loyalty'],
  },
];

const industries = [
  { name: 'Multi-Speciality Hospitals', desc: 'OPD, IPD, Operation Theatres, LIS & Pharmacy automation' },
  { name: 'Diagnostic Pathology Labs', desc: 'Bi-directional medical equipment and barcode interfacing' },
  { name: 'Specialist Clinics & Fertility', desc: 'Patient records, IVF cycle tracking, and digital prescriptions' },
  { name: 'Enterprise Companies', desc: 'Turnkey internal ERP, asset management, and CRM pipelines' },
  { name: 'Aesthetic & Cosmetic Centers', desc: 'Client packages, appointment bookings, and loyalty ledgers' },
  { name: 'Startups & Digital Brands', desc: 'Rapid web applications, cloud backends, and marketing automation' },
];
---

<Layout
  title="Digikhojindia | Hospital Systems, Custom Software & Business Automation"
  description="Digikhojindia automates your entire business. Enterprise hospital management (HMIS), custom software development, CRM pipelines, and IT infrastructure management."
>
  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden pt-24 pb-20 lg:pt-32 lg:pb-28 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.15),transparent_50%)] pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        
        <!-- Live Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-900/40 border border-blue-500/30 text-blue-300 text-xs font-semibold uppercase tracking-wider mb-8">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          <span>Next-Gen Cloudflare Native Architecture</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
          We Don't Just Build Software. <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-sky-300">
            We Automate Your Entire Business.
          </span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
          From full-scale <strong>Hospital Management Systems (HMIS)</strong> and <strong>Diagnostic LIS</strong> to custom business ERPs, CRM pipelines, and WhatsApp automation.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/request-demo"
            class="px-8 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-xl shadow-blue-600/30 transition-all transform hover:-translate-y-0.5"
          >
            Request a Live Demo →
          </a>
          <a
            href="/portfolio"
            class="px-8 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-semibold text-sm border border-slate-700 transition-all"
          >
            Explore Software Modules
          </a>
          <a
            href="/request-quote"
            class="px-8 py-3.5 rounded-xl bg-transparent hover:bg-slate-900 text-slate-300 font-semibold text-sm border border-slate-800 transition-all"
          >
            Get Custom Quote
          </a>
        </div>

        <!-- Highlight Trust Bar -->
        <div class="mt-16 pt-8 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <p class="text-2xl font-bold text-white">Sub-10ms</p>
            <p class="text-xs text-slate-400 mt-1">Cloudflare Edge Latency</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-blue-400">100% Paperless</p>
            <p class="text-xs text-slate-400 mt-1">Hospital OPD/IPD Automation</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-emerald-400">Lifetime Free</p>
            <p class="text-xs text-slate-400 mt-1">AMC Subject to Terms</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-sky-400">Multi-Tenant</p>
            <p class="text-xs text-slate-400 mt-1">Strict Isolated Security</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Services Section -->
  <section class="py-20 bg-slate-950 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-2">Complete Service Spectrum</h2>
        <h3 class="text-3xl font-bold text-white tracking-tight">Engineered for Reliability & Scale</h3>
        <p class="mt-4 text-sm text-slate-400">
          Everything your institution requires under one roof: from bespoke application engineering to hospital IT operations and search visibility.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((svc) => (
          <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6 hover:border-blue-500/50 hover:bg-slate-900 transition-all group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">{svc.icon}</span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-blue-400 bg-blue-950/60 px-2.5 py-1 rounded-md border border-blue-800/40">
                  {svc.badge}
                </span>
              </div>
              <h4 class="text-base font-semibold text-white group-hover:text-blue-400 transition-colors">
                {svc.title}
              </h4>
              <p class="mt-2 text-xs text-slate-400 leading-relaxed">
                {svc.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/60 flex items-center justify-between">
              <a href={svc.slug} class="text-xs font-semibold text-blue-400 hover:text-blue-300 flex items-center gap-1">
                <span>Learn Details</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Software Portfolio Section (Dynamic & Honest Showcase) -->
  <section class="py-20 bg-slate-900/50 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-2">Production-Ready Software</h2>
          <h3 class="text-3xl font-bold text-white tracking-tight">Our Software Portfolio</h3>
          <p class="mt-2 text-xs text-slate-400 max-w-xl">
            Each software module is built on high-performance Cloudflare Workers with strict multi-tenant isolation.
            <span class="text-amber-400 font-medium block mt-1">Notice: All demonstration modules below are sample/demo configurations awaiting client deployment confirmation.</span>
          </p>
        </div>
        <div class="mt-4 md:mt-0">
          <a href="/portfolio" class="inline-flex items-center text-xs font-semibold text-blue-400 hover:text-blue-300 gap-1 bg-slate-800 px-4 py-2 rounded-lg border border-slate-700">
            <span>Explore All 15 Categories</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolioItems.map((item) => (
          <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg hover:border-slate-700 transition-all flex flex-col">
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold text-blue-400 uppercase tracking-wider">{item.category}</span>
                  <span class="text-[10px] font-semibold bg-amber-950/60 text-amber-300 border border-amber-800/40 px-2 py-0.5 rounded">
                    {item.tag}
                  </span>
                </div>
                <h4 class="text-lg font-bold text-white mb-2">{item.name}</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">{item.description}</p>
                <div class="space-y-1.5 mb-6">
                  {item.features.map((f) => (
                    <div class="flex items-center gap-2 text-xs text-slate-300">
                      <span class="text-blue-400 font-bold">✓</span>
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
                <a href={`/request-demo?module=${item.id}`} class="text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 px-3.5 py-1.5 rounded-lg transition-colors">
                  Request Demo
                </a>
                <a href={`/portfolio#${item.id}`} class="text-xs text-slate-400 hover:text-white">
                  Technical Specs →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Industries We Serve -->
  <section class="py-20 bg-slate-950 border-t border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-2">Tailored Domain Expertise</h2>
        <h3 class="text-3xl font-bold text-white tracking-tight">Industries We Empower</h3>
        <p class="mt-4 text-sm text-slate-400">
          We understand clinical compliance, high-volume transactional workloads, and the need for zero downtime in mission-critical environments.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map((ind) => (
          <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800/80">
            <h4 class="text-base font-bold text-white mb-1">{ind.name}</h4>
            <p class="text-xs text-slate-400 leading-relaxed">{ind.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Signature Proposition: Lifetime Free AMC (Adhering to Section 10) -->
  <section class="py-16 bg-gradient-to-r from-blue-950/40 via-slate-900 to-blue-950/40 border-y border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 bg-blue-900/50 border border-blue-500/40 text-blue-300 text-xs font-semibold rounded-full uppercase tracking-wider mb-4">
        Our Commitment to Zero Maintenance Headaches
      </span>
      <h3 class="text-3xl font-extrabold text-white tracking-tight">
        "Lifetime Free AMC – Subject to agreed contract terms."
      </h3>
      <p class="mt-4 text-sm text-slate-300 leading-relaxed max-w-3xl mx-auto">
        When you partner with Digikhojindia for custom software or HMIS implementation, we provide perpetual software stability support under our agreed contract terms. We resolve bugs, perform security patches, and monitor system performance without surprise annual maintenance fee inflation.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-6 text-xs text-slate-400">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Priority Ticket SLA</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Automated Backup Audits</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Database Index Optimization</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Cloud Security Updates</span>
      </div>
      <div class="mt-8">
        <a href="/amc-policy" class="text-xs font-semibold text-blue-400 hover:underline">
          Read full AMC Policy & Contract Inclusions →
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Interactive Contact & Enquiry Form Section -->
  <section id="contact-form" class="py-24 bg-slate-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-950/60 border border-blue-800/40 text-blue-400 text-xs font-bold uppercase tracking-wider">
            Start Your Automation Journey
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Ready to Automate Your Business?
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Fill out the form to request a customized software demonstration or get an exact, itemized quotation for your hospital or business.
          </p>

          <div class="pt-4 space-y-4 text-xs text-slate-300">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-blue-400 text-sm">📧</span>
              <div>
                <p class="text-slate-400">Official Inquiries</p>
                <p class="font-semibold text-white">{BRAND_CONSTANTS.OFFICIAL_EMAIL}</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-blue-400 text-sm">👤</span>
              <div>
                <p class="text-slate-400">Executive Leadership</p>
                <p class="font-semibold text-white">{BRAND_CONSTANTS.OWNER_NAME} (Founder)</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-blue-400 text-sm">🔒</span>
              <div>
                <p class="text-slate-400">Security & Privacy</p>
                <p class="font-semibold text-white">Strict Enterprise Non-Disclosure & Multi-Tenant Isolation</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <EnquiryForm client:load defaultType="demo" />
        </div>

      </div>
    </div>
  </section>
</Layout>
