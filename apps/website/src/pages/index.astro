---
import Layout from '../layouts/Layout.astro';
import { EnquiryForm } from '../components/EnquiryForm';
import { BRAND_CONSTANTS } from '@digikhojindia/shared';

const services = [
  {
    title: 'Hospital Management Systems (HMIS)',
    slug: '/services/hospital-management',
    description: 'Paperless hospital automation with OPD, IPD, Bed scheduling, Doctor appointments, Billing & EHR.',
    badge: 'Flagship Healthcare',
    icon: '🏥',
    glow: 'from-blue-500/20 to-cyan-500/20',
  },
  {
    title: 'Custom Software Development',
    slug: '/services/custom-software',
    description: 'Bespoke web and cloud applications built specifically for your unique operational workflows.',
    badge: 'Enterprise',
    icon: '💻',
    glow: 'from-violet-500/20 to-pink-500/20',
  },
  {
    title: 'Business Process Automation',
    slug: '/services/business-automation',
    description: 'Eliminate repetitive manual entry. Connect enquiry intake, billing alerts, and tasks automatically.',
    badge: '10x Efficiency',
    icon: '⚡',
    glow: 'from-amber-500/20 to-orange-500/20',
  },
  {
    title: 'CRM & Lead Management',
    slug: '/services/crm-solutions',
    description: 'Multi-stage sales pipelines, instant lead capture from web forms, and follow-up reminders.',
    badge: 'Revenue Growth',
    icon: '📈',
    glow: 'from-emerald-500/20 to-teal-500/20',
  },
  {
    title: 'Website & Web Application Development',
    slug: '/services/website-development',
    description: 'Fast, secure, responsive web applications engineered with Cloudflare-native modern architecture.',
    badge: 'High Performance',
    icon: '🌐',
    glow: 'from-cyan-500/20 to-blue-500/20',
  },
  {
    title: 'Google Business Profile & Local SEO',
    slug: '/services/google-business-profile',
    description: 'Optimize local search visibility, manage verified locations, and drive high-intent local inquiries.',
    badge: 'GEO Visibility',
    icon: '📍',
    glow: 'from-rose-500/20 to-orange-500/20',
  },
  {
    title: 'AI & Generative Search Optimization (GEO)',
    slug: '/services/seo-geo',
    description: 'Structure your business knowledge and citations for next-generation AI engines and answer search.',
    badge: 'Future-Proof',
    icon: '🤖',
    glow: 'from-purple-500/20 to-cyan-500/20',
  },
  {
    title: 'IT Infrastructure & AMC Support',
    slug: '/services/it-infrastructure',
    description: 'Server management, networking, CCTV maintenance, and our signature Lifetime Free AMC terms.',
    badge: 'Lifetime Free AMC*',
    icon: '🛡️',
    glow: 'from-emerald-500/20 to-cyan-500/20',
  },
];

const portfolioItems = [
  {
    id: 'hmis',
    name: 'Hospital Management System (HMIS)',
    category: 'Healthcare HMIS',
    tag: 'Sample / Demo Module',
    description: 'End-to-end hospital administration: OPD/IPD registers, digital discharge summary, TPA billing, pharmacy.',
    features: ['OPD/IPD Management', 'Integrated Billing & TPA', 'Ayushman Bharat Ready', 'Pharmacy Inventory'],
  },
  {
    id: 'director-dashboard',
    name: 'Director / CEO Dashboard',
    category: 'Executive Cockpit',
    tag: 'Sample / Demo Module',
    description: 'Real-time financial and clinical intelligence: collection heatmaps, doctor performance, bed occupancy.',
    features: ['Real-time Collections', 'Bed Occupancy Matrix', 'Department Margins', 'Receivables Aging'],
  },
  {
    id: 'lis-analyzer',
    name: 'Laboratory Management & LIS Interfacing',
    category: 'Diagnostic LIS',
    tag: 'Sample / Demo Module',
    description: 'Bi-directional serial & TCP/IP ASTM interfacing with biochemistry and hematology analyzers.',
    features: ['ASTM / HL7 Protocol', 'Barcode Printing', 'Instant WhatsApp Reports', 'Auto-Normal Validation'],
  },
  {
    id: 'asset-management',
    name: 'Asset Management Portal',
    category: 'IT & Facilities',
    tag: 'Sample / Demo Module',
    description: 'QR-code tagging for medical equipment and IT machines, breakdown ticketing, and vendor AMC audits.',
    features: ['QR Maintenance Log', 'Preventive Service Alerts', 'Breakdown Tickets', 'Warranty Tracking'],
  },
  {
    id: 'whatsapp-automation',
    name: 'WhatsApp, SMS & IVR Automation',
    category: 'Communication',
    tag: 'Sample / Demo Module',
    description: 'Official Meta Cloud API integration for automated appointment reminders and billing notifications.',
    features: ['Meta Cloud API', 'DLT SMS Integration', 'Interactive IVR Routing', 'Instant Bot Answers'],
  },
  {
    id: 'salon-cosmetic',
    name: 'Cosmetic & Salon Management',
    category: 'Aesthetic Clinic',
    tag: 'Sample / Demo Module',
    description: 'Appointment schedules, package vouchers, therapist commission logs, and client treatment logs.',
    features: ['Appointment Scheduling', 'Package Memberships', 'Stylist Commissions', 'Customer Loyalty'],
  },
];

const industries = [
  { name: 'Multi-Speciality Hospitals', desc: 'OPD, IPD, Operation Theatres, LIS & Pharmacy automation', icon: '🏥' },
  { name: 'Diagnostic Pathology Labs', desc: 'Bi-directional medical equipment and barcode interfacing', icon: '🔬' },
  { name: 'Specialist Clinics & Fertility', desc: 'Patient records, IVF cycle tracking, and digital prescriptions', icon: '🩺' },
  { name: 'Enterprise Companies', desc: 'Turnkey internal ERP, asset management, and CRM pipelines', icon: '🏢' },
  { name: 'Aesthetic & Cosmetic Centers', desc: 'Client packages, appointment bookings, and loyalty ledgers', icon: '✨' },
  { name: 'Startups & Digital Brands', desc: 'Rapid web applications, cloud backends, and marketing automation', icon: '🚀' },
];
---

<Layout
  title="Digikhojindia | Hospital Systems, Custom Software & Business Automation"
  description="Digikhojindia automates your entire business. Enterprise hospital management (HMIS), custom software development, CRM pipelines, and IT infrastructure management."
>
  <!-- 1. Liquid Glass Hero Section -->
  <section class="relative overflow-hidden pt-24 pb-20 lg:pt-36 lg:pb-32">
    <!-- Ambient Luminous Glow Orbs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-r from-[#287BFF]/20 via-[#42DDF5]/15 to-[#9B70FF]/20 blur-[130px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        
        <!-- Live Liquid Pill Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/[0.04] backdrop-blur-md border border-cyan-400/30 text-cyan-300 text-xs font-semibold uppercase tracking-wider mb-8 shadow-[0_0_20px_rgba(66,221,245,0.2)]">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>OnePlus ColorOS-Inspired Liquid Glass SaaS</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white font-heading tracking-tight leading-[1.1]">
          We Don't Just Build Software. <br class="hidden sm:inline" />
          <span class="text-gradient-liquid">
            We Automate Your Entire Business.
          </span>
        </h1>

        <p class="mt-6 text-base sm:text-xl text-slate-300 leading-relaxed max-w-3xl mx-auto font-sans">
          From full-scale <strong>Hospital Information Systems (HMIS)</strong> and <strong>Diagnostic LIS</strong> to custom business ERPs, CRM pipelines, and WhatsApp automation.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/request-demo"
            class="relative group px-8 py-4 rounded-2xl bg-gradient-to-r from-[#287BFF] via-[#42DDF5] to-[#9B70FF] text-white font-bold text-sm shadow-[0_0_30px_rgba(66,221,245,0.4)] hover:shadow-[0_0_40px_rgba(40,123,255,0.6)] border border-white/20 transition-all transform hover:-translate-y-0.5 overflow-hidden flex items-center gap-2"
          >
            <span class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/80 to-transparent pointer-events-none"></span>
            <span>Request a Live Demo</span>
            <span class="text-lg">→</span>
          </a>

          <a
            href="/portfolio"
            class="px-8 py-4 rounded-2xl bg-[#102B50]/50 hover:bg-[#102B50]/80 text-cyan-300 hover:text-white font-bold text-sm backdrop-blur-md border border-cyan-500/30 shadow-[0_4px_25px_rgba(0,0,0,0.3)] transition-all hover:border-cyan-400/60"
          >
            Explore Software Modules
          </a>

          <a
            href="/request-quote"
            class="px-8 py-4 rounded-2xl bg-white/[0.04] hover:bg-white/10 text-slate-300 hover:text-white font-semibold text-sm backdrop-blur-md border border-white/10 transition-all"
          >
            Get Custom Quote
          </a>
        </div>

        <!-- Highlight Trust Bar (Liquid Glass Cards) -->
        <div class="mt-20 pt-10 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 text-center">
          <div class="p-4 rounded-2xl bg-white/[0.03] backdrop-blur-md border border-white/10">
            <p class="text-2xl sm:text-3xl font-black text-white font-heading">Sub-10ms</p>
            <p class="text-xs text-cyan-300 mt-1 font-medium">Cloudflare Edge Latency</p>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] backdrop-blur-md border border-white/10">
            <p class="text-2xl sm:text-3xl font-black text-gradient-liquid font-heading">100% Paperless</p>
            <p class="text-xs text-slate-300 mt-1 font-medium">Hospital OPD/IPD Automation</p>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] backdrop-blur-md border border-white/10">
            <p class="text-2xl sm:text-3xl font-black text-emerald-400 font-heading">Lifetime Free</p>
            <p class="text-xs text-emerald-300 mt-1 font-medium">AMC Subject to Terms</p>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] backdrop-blur-md border border-white/10">
            <p class="text-2xl sm:text-3xl font-black text-gradient-aurora font-heading">Multi-Tenant</p>
            <p class="text-xs text-violet-300 mt-1 font-medium">Strict Isolated Security</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Services Section (Liquid Glass Grid) -->
  <section class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-2 font-heading">Complete Service Spectrum</h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-heading">Engineered for Reliability & Scale</h3>
        <p class="mt-4 text-sm text-slate-300 leading-relaxed">
          Everything your institution requires under one roof: from bespoke application engineering to hospital IT operations and local search visibility.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((svc) => (
          <div class="relative group rounded-3xl p-6 bg-gradient-to-br from-white/[0.07] via-[#102B50]/30 to-white/[0.02] backdrop-blur-xl border border-white/10 hover:border-cyan-400/50 shadow-[0_8px_32px_0_rgba(0,0,0,0.37)] hover:shadow-[0_12px_40px_0_rgba(40,123,255,0.25)] transition-all duration-300 flex flex-col justify-between overflow-hidden">
            <!-- Subtle Top Line -->
            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/30 to-transparent pointer-events-none"></div>

            <div>
              <div class="flex items-center justify-between mb-5">
                <span class="text-3xl p-2 rounded-2xl bg-white/[0.05] border border-white/10 shadow-sm">{svc.icon}</span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-300 bg-cyan-950/60 px-2.5 py-1 rounded-full border border-cyan-500/30">
                  {svc.badge}
                </span>
              </div>
              <h4 class="text-base font-bold text-white font-heading group-hover:text-cyan-300 transition-colors">
                {svc.title}
              </h4>
              <p class="mt-2 text-xs text-slate-300 leading-relaxed">
                {svc.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between">
              <a href={svc.slug} class="text-xs font-semibold text-cyan-400 hover:text-white flex items-center gap-1.5 transition-colors">
                <span>Explore Specifications</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Software Portfolio Section -->
  <section class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-2 font-heading">Production-Ready Software</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-heading">Our Software Portfolio</h3>
          <p class="mt-2 text-xs text-slate-300 max-w-xl leading-relaxed">
            Each software module is built on high-performance Cloudflare Workers with strict multi-tenant isolation.
            <span class="text-amber-300 font-semibold block mt-1">Notice: All demonstration modules below are sample/demo configurations awaiting client deployment confirmation.</span>
          </p>
        </div>
        <div class="mt-4 md:mt-0">
          <a href="/portfolio" class="inline-flex items-center text-xs font-bold text-cyan-300 hover:text-white gap-2 bg-[#102B50]/60 px-4 py-2.5 rounded-xl border border-cyan-500/30 backdrop-blur-md shadow-sm">
            <span>Explore All 15 Categories</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolioItems.map((item) => (
          <div class="relative group rounded-3xl bg-gradient-to-br from-white/[0.07] via-[#102B50]/30 to-white/[0.02] backdrop-blur-xl border border-white/10 hover:border-violet-400/50 shadow-[0_8px_32px_0_rgba(0,0,0,0.37)] hover:shadow-[0_12px_40px_0_rgba(155,112,255,0.25)] transition-all duration-300 flex flex-col justify-between overflow-hidden">
            <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-violet-400/50 to-transparent pointer-events-none"></div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider font-heading">{item.category}</span>
                  <span class="text-[10px] font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30 px-2 py-0.5 rounded-full">
                    {item.tag}
                  </span>
                </div>
                <h4 class="text-lg font-bold text-white mb-2 font-heading group-hover:text-cyan-300 transition-colors">{item.name}</h4>
                <p class="text-xs text-slate-300 leading-relaxed mb-4">{item.description}</p>
                <div class="space-y-1.5 mb-6">
                  {item.features.map((f) => (
                    <div class="flex items-center gap-2 text-xs text-slate-300">
                      <span class="text-cyan-400 font-bold">✓</span>
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                <a href={`/request-demo?module=${item.id}`} class="text-xs font-bold text-white bg-gradient-to-r from-[#287BFF] to-[#42DDF5] hover:opacity-90 px-4 py-2 rounded-xl transition-all shadow-[0_0_15px_rgba(66,221,245,0.3)]">
                  Request Demo
                </a>
                <a href={`/portfolio#${item.id}`} class="text-xs text-slate-400 hover:text-white font-medium">
                  Technical Specs →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Industries We Serve -->
  <section class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-2 font-heading">Tailored Domain Expertise</h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-heading">Industries We Empower</h3>
        <p class="mt-4 text-sm text-slate-300">
          We understand clinical compliance, high-volume transactional workloads, and the need for zero downtime in mission-critical environments.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map((ind) => (
          <div class="p-6 rounded-3xl bg-white/[0.04] backdrop-blur-xl border border-white/10 hover:border-cyan-400/40 transition-all flex items-start gap-4">
            <span class="text-3xl p-2 rounded-2xl bg-white/5 border border-white/10">{ind.icon}</span>
            <div>
              <h4 class="text-base font-bold text-white font-heading">{ind.name}</h4>
              <p class="text-xs text-slate-300 leading-relaxed mt-1">{ind.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Signature Proposition: Lifetime Free AMC (Adhering to Section 10) -->
  <section class="py-20 relative">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="p-10 rounded-3xl bg-gradient-to-r from-[#102B50]/80 via-[#080D20]/90 to-[#102B50]/80 backdrop-blur-2xl border border-cyan-500/30 shadow-[0_0_50px_rgba(66,221,245,0.2)] relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-cyan-400 to-transparent"></div>

        <span class="inline-block px-3.5 py-1 bg-cyan-950/60 border border-cyan-500/40 text-cyan-300 text-xs font-bold rounded-full uppercase tracking-wider mb-4">
          Our Commitment to Zero Maintenance Headaches
        </span>

        <h3 class="text-3xl sm:text-4xl font-black text-white font-heading tracking-tight">
          "Lifetime Free AMC – <span class="text-emerald-400">Subject to agreed contract terms."</span>
        </h3>

        <p class="mt-4 text-sm text-slate-300 leading-relaxed max-w-3xl mx-auto">
          When you partner with Digikhojindia for custom software or HMIS implementation, we provide perpetual software stability support under our agreed contract terms. We resolve bugs, perform security patches, and monitor system performance without surprise annual maintenance fee inflation.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-6 text-xs text-slate-300 font-medium">
          <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> Priority Ticket SLA</span>
          <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> Automated Backup Audits</span>
          <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> Database Index Optimization</span>
          <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> Cloud Security Updates</span>
        </div>

        <div class="mt-8">
          <a href="/amc-policy" class="text-xs font-bold text-cyan-400 hover:text-white underline">
            Read full AMC Policy & Contract Inclusions →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Interactive Contact & Enquiry Form Section -->
  <section id="contact-form" class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/40 text-cyan-400 text-xs font-bold uppercase tracking-wider font-heading">
            Start Your Automation Journey
          </div>
          <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight font-heading leading-tight">
            Ready to Automate Your Business?
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Fill out the form to request a customized software demonstration or get an exact, itemized quotation for your hospital or business.
          </p>

          <div class="pt-4 space-y-4 text-xs text-slate-300">
            <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md">
              <span class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 text-base">📧</span>
              <div>
                <p class="text-slate-400 text-[11px]">Official Inquiries</p>
                <p class="font-bold text-white text-xs">{BRAND_CONSTANTS.OFFICIAL_EMAIL}</p>
              </div>
            </div>

            <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md">
              <span class="w-10 h-10 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 text-base">👤</span>
              <div>
                <p class="text-slate-400 text-[11px]">Executive Leadership</p>
                <p class="font-bold text-white text-xs">{BRAND_CONSTANTS.OWNER_NAME} (Founder)</p>
              </div>
            </div>

            <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/[0.04] border border-white/10 backdrop-blur-md">
              <span class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 text-base">🔒</span>
              <div>
                <p class="text-slate-400 text-[11px]">Security & Multi-Tenancy</p>
                <p class="font-bold text-white text-xs">Strict Zero-Leakage Architecture</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <EnquiryForm client:load defaultType="demo" />
        </div>

      </div>
    </div>
  </section>
</Layout>
