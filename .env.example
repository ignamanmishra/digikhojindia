# ============================================================
# DIGIKHOJINDIA PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Company: Digikhojindia
# Owner: Naman Mishra
# Official Email: info@digikhojindia.com
# ============================================================

# Platform Core
NODE_ENV=development
PLATFORM_NAME=Digikhojindia
PLATFORM_TAGLINE="We Don't Just Build Software. We Automate Your Entire Business."
OWNER_NAME="Naman Mishra"
SUPPORT_EMAIL=info@digikhojindia.com

# Domain Configuration (Never hardcode production domains; keep fully configurable)
APP_DOMAIN=localhost:3000
API_BASE_URL=http://localhost:8787
WEBSITE_URL=http://localhost:4321
ADMIN_URL=http://localhost:5173
PORTAL_URL=http://localhost:5174


# Authentication & Security
# Generate secure 64-character secrets for production
SESSION_SECRET=super_secret_session_key_min_32_characters_random_string_dev
JWT_SECRET=super_secret_jwt_key_min_32_characters_random_string_dev
PASSWORD_SALT_ROUNDS=100000
COOKIE_SECURE=false

# Cloudflare D1 Database Binding (Configured in wrangler.toml)
# DB_BINDING_NAME=DB

# Cloudflare R2 Object Storage (Configured in wrangler.toml)
# R2_BUCKET_NAME=digikhojindia-storage
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_PUBLIC_URL=http://localhost:8787/api/files

# Cloudflare Turnstile Bot Defense
# Get keys from Cloudflare Dashboard -> Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Integrations (Optional / Configured via Admin Panel or Env)
# Email Integration (SMTP / Resend / SendGrid)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder_api_key
EMAIL_FROM="Digikhojindia <info@digikhojindia.com>"

# WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
WHATSAPP_ACCESS_TOKEN=placeholder_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_waba_id

# SMS Provider Integration (Fast2SMS / Twilio)
SMS_API_KEY=placeholder_sms_key
SMS_SENDER_ID=DKIIND

# Google Business Profile / Google Services Integration
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/integrations/google/callback
